{
  "name": "Automation Video - Real Character Pipeline",
  "nodes": [
    {"parameters": {}, "id": "1", "name": "00 Manual Trigger", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 300]},
