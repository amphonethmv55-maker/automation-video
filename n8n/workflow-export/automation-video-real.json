    {"parameters": {"jsCode": "const merged = $items('05 Merge Scene + Character');\nreturn $input.all().map((item, index) => { const base = merged[index].json; return { json: { ...base, image_result: item.json } }; });"}, "id": "8", "name": "07b Merge Character Asset", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1650, 300]},
